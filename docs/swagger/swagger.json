{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Local service access and browser authorization. Wallet APIs are delivered in later iterations.",
        "title": "Wallet Bridge Local API",
        "contact": {},
        "version": "1.2"
    },
    "host": "127.0.0.1:18765",
    "basePath": "/api/v1",
    "paths": {
        "/browser/authorize": {
            "post": {
                "description": "Requires Origin http://127.0.0.1:18765, including for native HTTP callers. The ticket is consumed once; after a failed or lost exchange request a new link. Cookie is host-only, HttpOnly, SameSite=Strict, Path=/api/v1, with fixed expiration. The HTTP loopback cookie does not use Secure. JSON never returns the cookie secret. Request body is limited to 1024 bytes; query parameters are rejected.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Exchange a one-time ticket for browser authorization",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Exact local service origin",
                        "name": "Origin",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "One-use ticket from the link fragment",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.BrowserAuthorizeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.BrowserGrantResponse"
                        },
                        "headers": {
                            "Set-Cookie": {
                                "type": "string",
                                "description": "Persistent browser management cookie"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "Request Entity Too Large",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "415": {
                        "description": "Unsupported Media Type",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/browser/logout": {
            "post": {
                "security": [
                    {
                        "BrowserCookie": []
                    }
                ],
                "description": "Requires the browser cookie and exact local Origin, even when a Bearer token is also present. Revokes the persistent grant before expiring its cookie. Accepts no body or an empty JSON object, limited to 1024 bytes; query parameters are rejected.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Log out the current browser",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Exact local service origin",
                        "name": "Origin",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.BrowserRevokeResponse"
                        },
                        "headers": {
                            "Set-Cookie": {
                                "type": "string",
                                "description": "Expires the current browser management cookie"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "Request Entity Too Large",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "415": {
                        "description": "Unsupported Media Type",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/control/browser-grants": {
            "get": {
                "security": [
                    {
                        "ServiceBearer": []
                    }
                ],
                "description": "Requires the local service token; browser cookies cannot list grants. Includes active, expired and revoked records, newest first. The cursor is the last grant ID from the preceding page. Secrets and their digests are never returned.",
                "produces": [
                    "application/json"
                ],
                "summary": "List browser authorizations",
                "parameters": [
                    {
                        "maximum": 50,
                        "minimum": 1,
                        "type": "integer",
                        "description": "Page size (default 50)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Last grant ID of the preceding page",
                        "name": "after",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.BrowserGrantListResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "ServiceBearer": []
                    }
                ],
                "description": "Requires the local service token. The URL contains a two-minute, one-use secret in its fragment. Do not log or expose it in ordinary status output. Accepts no body or an empty JSON object.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Issue a browser authorization link",
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/api.BrowserTicketResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "Request Entity Too Large",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "415": {
                        "description": "Unsupported Media Type",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too Many Requests",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/control/browser-grants/revoke": {
            "post": {
                "security": [
                    {
                        "ServiceBearer": []
                    }
                ],
                "description": "Requires the local service token. Choose a single grant id or all=true, exclusively. Repeating revocation of an existing record succeeds without changing its first revocation time. Revoke-all also invalidates all outstanding authorization links. Request body is limited to 1024 bytes; query parameters are rejected.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Revoke browser authorization",
                "parameters": [
                    {
                        "description": "Grant ID or all=true",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.BrowserRevokeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.BrowserRevokeResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "Request Entity Too Large",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "415": {
                        "description": "Unsupported Media Type",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/control/stop": {
            "post": {
                "security": [
                    {
                        "ServiceBearer": []
                    }
                ],
                "description": "Requires the local service token. Accepts no body or an empty JSON object, limited to 1024 bytes. HTTP 202 means shutdown was requested, not that the process has exited.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Request graceful service shutdown",
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/api.StopResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "Request Entity Too Large",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "415": {
                        "description": "Unsupported Media Type",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/info": {
            "get": {
                "description": "A 64-character lowercase hexadecimal challenge produces an HMAC-SHA256 proof binding the response metadata. No credentials or data directory are returned.",
                "produces": [
                    "application/json"
                ],
                "summary": "Read service version and capabilities",
                "parameters": [
                    {
                        "maxLength": 64,
                        "minLength": 64,
                        "type": "string",
                        "description": "32-byte nonce encoded as lowercase hexadecimal",
                        "name": "challenge",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.InfoResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/status": {
            "get": {
                "security": [
                    {
                        "ServiceBearer": []
                    },
                    {
                        "BrowserCookie": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Read authenticated service status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.StatusResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.APIVersion": {
            "type": "object",
            "properties": {
                "major": {
                    "type": "integer",
                    "example": 1
                },
                "minor": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "api.BrowserAuthorizeRequest": {
            "type": "object",
            "properties": {
                "ticket": {
                    "type": "string"
                }
            }
        },
        "api.BrowserGrantListResponse": {
            "type": "object",
            "properties": {
                "grants": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/api.BrowserGrantResponse"
                    }
                },
                "nextAfter": {
                    "type": "string"
                }
            }
        },
        "api.BrowserGrantResponse": {
            "type": "object",
            "properties": {
                "expiresAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "id": {
                    "type": "string"
                },
                "issuedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "revokedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "state": {
                    "type": "string",
                    "enum": [
                        "active",
                        "expired",
                        "revoked",
                        "not_yet_valid"
                    ]
                }
            }
        },
        "api.BrowserRevokeRequest": {
            "type": "object",
            "properties": {
                "all": {
                    "type": "boolean"
                },
                "id": {
                    "type": "string"
                }
            }
        },
        "api.BrowserRevokeResponse": {
            "type": "object",
            "properties": {
                "state": {
                    "type": "string",
                    "example": "revoked"
                }
            }
        },
        "api.BrowserTicketResponse": {
            "type": "object",
            "properties": {
                "expiresAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "api.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "unauthenticated"
                },
                "message": {
                    "type": "string",
                    "example": "A valid Bearer token is required"
                }
            }
        },
        "api.InfoResponse": {
            "type": "object",
            "properties": {
                "apiVersion": {
                    "$ref": "#/definitions/api.APIVersion"
                },
                "capabilities": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "service.status",
                        "service.stop",
                        "browser.authorization"
                    ]
                },
                "challenge": {
                    "type": "string"
                },
                "name": {
                    "type": "string",
                    "example": "wallet-bridge"
                },
                "proof": {
                    "type": "string"
                },
                "ready": {
                    "type": "boolean",
                    "example": true
                },
                "version": {
                    "type": "string",
                    "example": "dev"
                }
            }
        },
        "api.StatusResponse": {
            "type": "object",
            "properties": {
                "browser": {
                    "$ref": "#/definitions/api.BrowserGrantResponse"
                },
                "info": {
                    "$ref": "#/definitions/api.InfoResponse"
                },
                "startedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "state": {
                    "type": "string",
                    "example": "running"
                }
            }
        },
        "api.StopResponse": {
            "type": "object",
            "properties": {
                "state": {
                    "type": "string",
                    "example": "stopping"
                }
            }
        }
    },
    "securityDefinitions": {
        "BrowserCookie": {
            "description": "Swagger 2.0 represents this cookie as a header. Use wallet_bridge_browser=\u003csecret\u003e; only browser status and logout accept it. Browser clients receive it through Set-Cookie, never through JSON.",
            "type": "apiKey",
            "name": "Cookie",
            "in": "header"
        },
        "ServiceBearer": {
            "description": "Bearer token from the current user's client.key, shared by trusted local clients for service access and management.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}