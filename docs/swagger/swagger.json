    },
    "host": "127.0.0.1:18765",
    "basePath": "/api/v1",
    "paths": {
        "/browser/authorize": {
            "post": {
                "description": "Requires Origin http://127.0.0.1:18765, including for native HTTP callers. The ticket is consumed once; after a failed or lost exchange request a new link. Cookie is host-only, HttpOnly, SameSite=Strict, Path=/api/v1, with fixed expiration. The HTTP loopback cookie does not use Secure. JSON never returns the cookie secret. Request body is limited to 1024 bytes; query parameters are rejected.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Exchange a one-time ticket for browser authorization",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Exact local service origin",
                        "name": "Origin",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "One-use ticket from the link fragment",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.BrowserAuthorizeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.BrowserGrantResponse"
                        },
                        "headers": {
                            "Set-Cookie": {
                                "type": "string",
                                "description": "Persistent browser management cookie"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "Request Entity Too Large",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "415": {
                        "description": "Unsupported Media Type",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
