{
  "name": "@wallet-bridge/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "bundle": "node ../scripts/build.mjs",
    "bundle:all": "node ../scripts/build.mjs --all",
    "swagger": "node ../scripts/swagger.mjs",
    "service:smoke": "node ../scripts/service-smoke.mjs",
    "background:smoke": "node ../scripts/background-smoke.mjs",
    "browser:install": "playwright install chromium",
    "test:e2e": "playwright test --project=chromium",
    "pretry:connection": "npm run bundle",
    "try:connection": "node ../scripts/try-connection.mjs",
    "test:e2e:chrome": "playwright test --project=chrome",
    "test:wallet": "playwright test --config playwright.wallet.config.ts --project=chromium",
    "test:wallet:chrome": "playwright test --config playwright.wallet.config.ts --project=chrome",
    "smoke": "node ../scripts/smoke.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
